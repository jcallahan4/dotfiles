# nvim setup
alias vim="nvim"

# history setup
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# autocomplete using arrow keys (based on history)
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# zsh plugins: source from whichever prefix has them. On macOS that's the
# Homebrew share dir; on Debian/Ubuntu apt installs them under /usr/share.
for _plugin_prefix in \
  "$(command -v brew >/dev/null 2>&1 && brew --prefix)/share" \
  /usr/share; do
  [ -f "$_plugin_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh" ] \
    && source "$_plugin_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$_plugin_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] \
    && source "$_plugin_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
done
unset _plugin_prefix


