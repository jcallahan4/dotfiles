# Task runner. `just --list` shows recipes. Agents: use these, don't invent commands.
set shell := ["zsh", "-cu"]
pkg := "{{PACKAGE}}"

default:
    @just --list

# Whole pipeline in under a minute. Run before anything long.
smoke:
    uv run python -m {{pkg}}.run --config configs/smoke.yaml

# Run one experiment's config: `just run 003-huber-vs-mse`
run exp:
    uv run python -m {{pkg}}.run --config experiments/{{exp}}/config.yaml

test:
    uv run pytest -q

lint:
    uv run ruff format .
    uv run ruff check --fix .

# Table of every runs/*/summary.json
report:
    uv run python -m {{pkg}}.report runs/

# Diff everything since a tag: `just since baseline`
since tag:
    git diff --stat {{tag}}..HEAD

# Render one figure script once: `just fig example` -> paper/figures/example.pdf
fig name:
    uv run python figures/{{name}}.py

# Iterate on a figure: rerun on every save of figures/{{name}}.py, open the PDF in Skim once.
watch name:
    just fig {{name}} && open -a Skim paper/figures/{{name}}.pdf
    watchexec -w figures/{{name}}.py -w src -- uv run python figures/{{name}}.py

# Render every figure script.
figs:
    for f in figures/*.py; do uv run python "$f"; done

paper:
    cd paper && latexmk -pdf -interaction=nonstopmode -halt-on-error paper.tex

clean:
    rm -rf .pytest_cache .ruff_cache runs/scratch runs/smoke
